functio descifrar_un_rondo(bloque : integer[]) -> nihil {
    si (ingredere(0x76543210)) {
        custodi(0, 0x11111111, 0x22222222, 0x33333333, 0x44444444);
        desfeistel(bloque, 0, 0);
    }
}

functio principale() -> integer {
    varia bloque : integer[2] = {0xCAFEBABE, 0x79120F5A};
    descifrar_un_rondo(bloque);
    si (bloque[0] == 0xDEADBEEF et bloque[1] == 0xCAFEBABE) {
        redde 0;
    }
    redde 1;
}
